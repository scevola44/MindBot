<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MindBot.Bot-cdde26f0-0d0b-4417-ab2e-9374d963c855</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting, HTTP and the minimal-API stack come from the ASP.NET Core shared framework
         that Microsoft.NET.Sdk.Web references implicitly, so they are not listed here. -->
    <PackageReference Include="Telegram.Bot" Version="22.10.2.1" />
    <!-- Design-time only: required by `dotnet ef migrations add`, not shipped in the container. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindBot.Core\MindBot.Core.csproj" />
    <ProjectReference Include="..\MindBot.Infrastructure\MindBot.Infrastructure.csproj" />
  </ItemGroup>
</Project>
